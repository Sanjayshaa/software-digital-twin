{
  "name": "software-digital-twin",
  "version": "0.1.0",
  "description": "AI-Powered Software Digital Twin for Change Impact Analysis",
  "scripts": {
    "dev": "./.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir backend --reload",
    "start": "./.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir backend",
    "test": "PYTHONPATH=backend ./.venv/bin/pytest backend/tests",
    "test:quick": "PYTHONPATH=backend ./.venv/bin/pytest backend/tests -q",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "digital-twin",
    "ast",
