# ====================================================================
# Digital Twin Environment Configuration
# ====================================================================

# Application
PROJECT_NAME="AI-Powered Software Digital Twin"
VERSION="0.1.0"
APP_ENV="development"
API_V1_STR="/api/v1"

# Database Configuration
# Enterprise Cloud Database (Supabase PostgreSQL 17 or AWS RDS)
POSTGRES_SERVER="db.your-project-ref.supabase.co"
POSTGRES_PORT=5432
POSTGRES_USER="digitaltwin_app"
POSTGRES_PASSWORD="replace_with_secure_password"
POSTGRES_DB="postgres"

# Enterprise Database Connection URL (Direct with SSL)
DATABASE_URL_OVERRIDE="postgresql+psycopg2://digitaltwin_app:replace_with_secure_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# Enterprise Connection Pooler URL (For high-concurrency environments)
# DATABASE_URL_POOLER="postgresql+psycopg2://digitaltwin_app.your-project-ref:replace_with_secure_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"


# Multi-Provider AI / LLM Configuration
LLM_PROVIDER="gemini" # Options: gemini, openai, anthropic, mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL_NAME="gemini-1.5-pro"
