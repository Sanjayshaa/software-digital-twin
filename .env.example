# ====================================================================
# Digital Twin Environment Configuration
# ====================================================================

# Application
PROJECT_NAME="AI-Powered Software Digital Twin"
VERSION="0.1.0"
APP_ENV="development"
API_V1_STR="/api/v1"

# Database Configuration (Mapped to 5434 on host to avoid port 5432/54322 collision)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5434
POSTGRES_USER="digitaltwin"
POSTGRES_PASSWORD="digitaltwin_secret_password"
POSTGRES_DB="digitaltwin_db"

# Optional Database URL override (e.g. for CI or Cloud)
# DATABASE_URL_OVERRIDE="postgresql+psycopg2://digitaltwin:digitaltwin_secret_password@localhost:5434/digitaltwin_db"

# Multi-Provider AI / LLM Configuration
LLM_PROVIDER="gemini" # Options: gemini, openai, anthropic, mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL_NAME="gemini-1.5-pro"
